# syntax=docker/dockerfile:1

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY src/Auditoria.Notificaciones/Auditoria.Notificaciones.csproj src/Auditoria.Notificaciones/
RUN dotnet restore src/Auditoria.Notificaciones/Auditoria.Notificaciones.csproj
COPY src/Auditoria.Notificaciones/ src/Auditoria.Notificaciones/
RUN dotnet publish src/Auditoria.Notificaciones/Auditoria.Notificaciones.csproj -c Release -o /app/publish --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/runtime:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
USER $APP_UID
ENTRYPOINT ["dotnet", "Auditoria.Notificaciones.dll"]
